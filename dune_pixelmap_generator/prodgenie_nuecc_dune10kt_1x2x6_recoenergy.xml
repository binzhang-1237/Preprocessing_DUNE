    <tag>&release;</tag>
    <qual>e17:prof</qual>
    <local>/pnfs/dune/scratch/users/iseong/mydev/local.tar</local>
  </larsoft>

  <!-- Project stages -->
  <stage name="recoE">
    <fcl>recoenergys.fcl</fcl>
    <jobsub>--expected-lifetime=48h</jobsub>
    <maxfilesperjob>1</maxfilesperjob>
    <inputdef>iseong_prodgenie_nuecc_mergeana</inputdef>
    <outdir>/pnfs/dune/scratch/users/iseong/&release;/recoE_nuecc2/&name;</outdir>
    <output>&name;_${PROCESS}_%tc_recoE.root</output>
    <workdir>/pnfs/dune/scratch/users/iseong/work/&release;/recoE_nuecc2/&name;</workdir>
    <numjobs>1010</numjobs>
    <datatier>full-reconstructed</datatier>
    <defname>&name;_&tag;</defname>
  </stage>
  <!--  <numjobs>1010</numjobs> -->
  <stage name="nuemcc10">
    <fcl>recoenergys.fcl</fcl>
    <jobsub>--expected-lifetime=24h</jobsub>
    <maxfilesperjob>1</maxfilesperjob>
    <inputdef>prodgenie_nue_dune10kt_1x2x6_mcc10.0</inputdef>
    <outdir>/pnfs/dune/scratch/users/iseong/&release;/recoE_nue_mcc10/&name;</outdir>
    <output>&name;_${PROCESS}_%tc_recoE.root</output>
    <workdir>/pnfs/dune/scratch/users/iseong/work/&release;/recoE_nue_mcc10/&name;</workdir>
    <numjobs>513</numjobs>
    <datatier>full-reconstructed</datatier>
    <defname>&name;_&tag;</defname>
  </stage>


  <!-- file type -->
  <filetype>&file_type;</filetype>

  <!-- run type -->
  <runtype>&run_type;</runtype>

</project>
</job>
