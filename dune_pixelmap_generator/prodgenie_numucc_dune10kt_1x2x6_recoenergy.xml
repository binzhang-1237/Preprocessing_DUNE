<?xml version="1.0"?>

<!DOCTYPE project [
<!ENTITY release "v07_07_01">
<!ENTITY file_type "mc">
<!ENTITY run_type "physics">
<!ENTITY name "numu_dune10kt_1x2x6">
<!ENTITY tag "devel">
]>

<job>

<project name="&name;_recoE">
  <group>dune</group>

  <!-- Project size -->
  <numevents>10000000</numevents>

  <!-- Operating System -->
  <os>SL6</os>

  <!-- Batch resources -->
  <resource>DEDICATED,OPPORTUNISTIC</resource>

  <!-- metadata parameters -->
  <parameter name ="MCName">numu_dune10kt_1x2x6</parameter>
  <parameter name ="MCDetectorType">10kt</parameter>
  <parameter name ="MCGenerators">GENIE</parameter>
 
  <!-- Larsoft information -->
  <larsoft>
    <tag>&release;</tag>
    <qual>e17:prof</qual>
    <local>/pnfs/dune/scratch/users/iseong/mydev/local.tar</local>
  </larsoft>

  <!-- Project stages -->
  <stage name="numu_train">
    <fcl>recoenergys.fcl</fcl>
    <jobsub>--expected-lifetime=24h</jobsub>
    <maxfilesperjob>1</maxfilesperjob>
    <memory> 5000 </memory>
    <inputdef>iseong_numu_mcc10_mergeana_train_set</inputdef>
    <outdir>/pnfs/dune/scratch/users/iseong/&release;/recoE_numu_train2/&name;</outdir>
    <output>&name;_${PROCESS}_%tc_recoE.root</output>
    <workdir>/pnfs/dune/scratch/users/iseong/work/&release;/recoE_numu_train2/&name;</workdir>
    <numjobs>461</numjobs>
    <datatier>full-reconstructed</datatier>
    <defname>&name;_&tag;</defname>
  </stage>
  <!--  <numjobs>1010</numjobs> -->
  <stage name="numu_valid">
    <fcl>recoenergys.fcl</fcl>
    <jobsub>--expected-lifetime=48h</jobsub>
    <maxfilesperjob>1</maxfilesperjob>
    <inputdef>iseong_numu_mcc10_mergeana_valid_set</inputdef>
    <outdir>/pnfs/dune/scratch/users/iseong/&release;/recoE_numu_valid/&name;</outdir>
    <output>&name;_${PROCESS}_%tc_recoE.root</output>
    <workdir>/pnfs/dune/scratch/users/iseong/work/&release;/recoE_numu_valid/&name;</workdir>
    <numjobs>116</numjobs>
    <datatier>full-reconstructed</datatier>
    <defname>&name;_&tag;</defname>
  </stage>

  <stage name="numu_train_mcc11">
    <fcl>recoenergys.fcl</fcl>
    <jobsub>--expected-lifetime=24h</jobsub>
    <memory> 5000 </memory>
    <inputdef>iseong_mcc11_numu_train_set</inputdef>
    <outdir>/pnfs/dune/scratch/users/iseong/&release;/recoE_numu_mcc11_train/&name;</outdir>
    <output>&name;_${PROCESS}_%tc_recoE.root</output>
    <workdir>/pnfs/dune/scratch/users/iseong/work/&release;/recoE_numu_mcc11_train/&name;</workdir>
    <numjobs>500</numjobs>
    <datatier>full-reconstructed</datatier>
    <defname>&name;_&tag;</defname>
  </stage>
  <!--  <numjobs>1010</numjobs> -->
  <stage name="numu_valid_mcc11">
    <fcl>recoenergys.fcl</fcl>
    <jobsub>--expected-lifetime=48h</jobsub>
    <inputdef>iseong_mcc11_numu_valid_set</inputdef>
    <outdir>/pnfs/dune/scratch/users/iseong/&release;/recoE_numu_mcc11_valid/&name;</outdir>
    <output>&name;_${PROCESS}_%tc_recoE.root</output>
    <workdir>/pnfs/dune/scratch/users/iseong/work/&release;/recoE_numu_mcc11_valid/&name;</workdir>
    <numjobs>100</numjobs>
    <datatier>full-reconstructed</datatier>
    <defname>&name;_&tag;</defname>
  </stage>

  <!-- file type -->
  <filetype>&file_type;</filetype>

  <!-- run type -->
  <runtype>&run_type;</runtype>

</project>
</job>
